# Modelo do .env de PRODUÇÃO (BG-24) — copie para .env na VPS e preencha.
# Nunca commite o .env de verdade. Senhas e chaves: gere novas, nunca reaproveite as de desenvolvimento.
# Gerar valor aleatório:  openssl rand -hex 32

# Domínio (sem https://). O site fica em https://DOMINIO e a API em https://api.DOMINIO
DOMINIO=donaberedoces.com.br
# Recebe avisos do Let's Encrypt sobre o certificado HTTPS
ACME_EMAIL=seu-email@exemplo.com

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bere_gestao
MYSQL_USER=bere_user
MYSQL_PASSWORD=

# FastAPI / JWT — trocar a SECRET_KEY derruba todas as sessões e invalida os códigos de e-mail pendentes
SECRET_KEY=
ALGORITHM=HS256

# Mercado Pago — credenciais de PRODUÇÃO (Suas integrações › aplicação › Credenciais de produção)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# Gerado ao salvar o webhook no painel (Webhooks › Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=false

# E-mail — Brevo (Configurações › SMTP & API › SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SEGURANCA=starttls
# "Login" mostrado no painel do Brevo (algo como 9a1b2c001@smtp-brevo.com), não o e-mail da conta
SMTP_USER=
# Chave SMTP gerada no Brevo (não é a senha da conta)
SMTP_PASSWORD=
# Remetente num domínio autenticado no Brevo (SPF/DKIM)
SMTP_REMETENTE=nao-responda@donaberedoces.com.br

# Backup (BG-23) — opcional, ver README
# BACKUP_REMOTO=drive-cripto: